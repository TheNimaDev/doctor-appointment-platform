# System Setting
PORT = 3000
APP_NAME = Doctor Appointment Platform
BASE_URL = api/v1
NODE_ENV = development

# DB Setting
DB_HOST = localhost
DB_PORT = 3306
DB_USERNAME = root
DB_PASSWORD = 
DB_NAME = doctor_appointment_platform
DB_SYNCHRONIZE = false
DB_LOGGING = false

# Email Setting
EMAIL_EXPIRES = 10
EMAIL_COOLDOWN = 1

# Email SMTP Configuration
EMAIL_HOST = mail.example.com
EMAIL_PORT = 587
EMAIL_USER = noreply@example.com
EMAIL_PASS = your-email-password
EMAIL_FROM = "Doctor Platform <noreply@example.com>"

# JWT Secret
JWT_EXPIRES = 1h
REFRESH_TOKEN_EXPIRES = 12h
REFRESH_TOKEN_REMEMBER_EXPIRES = 7d
# Generate:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_TOKEN_SECRET = "JWT_TOKEN_SECRET"